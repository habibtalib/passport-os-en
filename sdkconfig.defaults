# Target
CONFIG_IDF_TARGET="esp32c3"

# Flash 8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Offline merge-bin requires a concrete flash size, not detect.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console: USB-Serial-JTAG (GPIO 18/19)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS & System
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Used only by the big Home clock (48px digits). The glyphs are ~100KB, all in flash .rodata, and
# mapped directly via the MMU, so they use no SRAM. The C3 has no PSRAM; never load glyphs into RAM.
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
# Use the shared ESP-IDF heap for LVGL. Screens are destroyed during app
# transitions, so their memory is returned to the same heap that Xiaozhi uses
# for TLS and Opus instead of permanently reserving a 24 KB private pool.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Audio Decoders (esp_audio_codec)
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y

# TLS & Certificates
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# Xiaozhi WebSocket control/audio frames and the observed Muse TLS records fit
# within 8 KiB. Dynamic buffers keep TLS memory scoped to active connections.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# Web server & HTTP
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# Wi-Fi Memory Tuning
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=768

# Bluetooth LE (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_UTIL_API=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Android Muse writes negotiated MTU minus 3 without an additional 512-byte cap.
# MTU 256 keeps provisioning chunks within Android's GATT write limit.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# main task stack: the Home app runs LVGL TJPEG decoder_info (file source) on the main task;
# its on-stack workb[TJPGD_WORKBUFF_SIZE] is ~3.1KB, so 3584 always overflows (2026-09-13 on-device
# Stack protection fault boot loop; addr2line pointed at lv_tjpgd.c:82).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# SRAM budget: the C3 has no PSRAM; IRAM and DRAM share 321KB SRAM, so every IRAM byte saved is one more heap byte.
# -Os plus the flash placement below frees ~40KB of heap (IRAM .text 86.5KB -> 46.6KB) and shrinks the firmware ~230KB.
# Precondition: no IRAM ISRs in the project (no IRAM_ATTR / ESP_INTR_FLAG_IRAM); ringbuf is only used from tasks.
# SPI_FLASH_AUTO_SUSPEND stays off: suspend is risky on XMC chips, so LOG/timer etc. stay in IRAM.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
# Production flash chips are XMC (generic driver); GD is kept as a fallback. Switching vendors requires re-enabling that driver.
CONFIG_SPI_FLASH_SUPPORT_ISSI_CHIP=n
CONFIG_SPI_FLASH_SUPPORT_MXIC_CHIP=n
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=n
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=n
CONFIG_SPI_FLASH_SUPPORT_TH_CHIP=n
